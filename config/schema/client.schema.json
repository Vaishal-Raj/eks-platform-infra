{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Client environment config",
  "type": "object",
  "additionalProperties": false,
  "required": ["client_id", "environment", "profile", "account_id", "region", "vpc_cidr"],
  "properties": {
    "client_id":   { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,20}[a-z0-9]$" },
    "environment": { "enum": ["dev", "staging", "prod"] },
    "profile":     { "type": "string" },
    "account_id":  { "type": "string", "pattern": "^[0-9]{12}$" },
    "region":      { "type": "string", "pattern": "^[a-z]{2}(-[a-z]+)+-[0-9]$" },
    "vpc_cidr":    { "type": "string", "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}/16$" },
    "exclude_zone_ids": {
      "type": "array",
      "items": { "type": "string" }
    },
    "tags": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "overrides": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "network":   { "type": "object" },
        "endpoints": { "type": "object" }
      }
    }
  }
}